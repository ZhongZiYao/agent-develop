# ===== 前端 Dockerfile（开发模式 + 热加载）=====
# 单阶段开发镜像：直接装包 + 跑 next dev，源代码通过 volume 挂载进去

FROM node:20-alpine

# 国内 npm 镜像加速
RUN npm config set registry https://registry.npmmirror.com

WORKDIR /app

# 先复制 package.json 利用 Docker 缓存层
COPY web/package*.json ./

# 装依赖
RUN npm install --no-audit --no-fund

# 不在这里 COPY web/，因为源代码通过 volume 挂载（热加载）

# 开放 Next.js dev server 端口
EXPOSE 3000

# Next.js dev server 默认监听 0.0.0.0:3000，配合 Next.js 配置支持热加载
ENV NEXT_TELEMETRY_DISABLED=1
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true

CMD ["npm", "run", "dev"]