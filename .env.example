# LLM API Keys（请填入你的 key，不要 commit）
QWEN_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LangSmith（可选）
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=gameguide-ai

# Embedding 模型
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Vector Store
CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=gameguide

# 业务参数
DEFAULT_TOP_K=50
DEFAULT_TOP_N=5
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# 服务端口
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501