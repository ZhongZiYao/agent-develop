# ===== LLM（默认：Ollama 本地 Qwen3）=====
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=180
LLM_CONTEXT_WINDOW=8192
LLM_REASONING=true
LLM_KEEP_ALIVE=15m

# 如需切换 MiniMax：
# LLM_PROVIDER=minimax
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.minimax.cn/v1
# LLM_MODEL=MiniMax-M3

# ===== Embedding（Ollama 本地）=====
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIM=1024

# ===== Vector Store =====
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=gameguide

# ===== 数据 =====
RAW_DATA_DIR=./data/raw
EVAL_DATA_DIR=./data/eval
PROCESSED_DATA_DIR=./data/processed

# ===== Splitter =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===== Retriever =====
TOP_K=10
TOP_N=5

# ===== Reranker（Phase 2 启用） =====
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-large

# ===== Query 处理（Phase 2 启用） =====
QUERY_REWRITE_ENABLED=false
HYDE_ENABLED=false

# ===== 服务 =====
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# ===== LangSmith（可选） =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gameguide-ai

# ===== 调试 =====
DEBUG=false

# ===== LangGraph Feature Flag =====
USE_LANGGRAPH=false

# ===== Phase 6.6 Self-RAG =====
ENABLE_SELF_RAG=true

# ===== Phase 6.7 Agent Trace =====
ENABLE_AGENT_TRACE=true

# ===== Phase 7 ETL 新增 =====

# ETL 数据根目录
DATA_DIR=./data

# DuckDB 数仓文件路径
WAREHOUSE_DIR=./data/warehouse

# Qdrant sidecar（Docker 启动后访问）
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=gameguide_phase7

# Chroma 向量库（Phase 7 新 collection）
CHROMA_PHASE7_COLLECTION=gameguide_phase7

# Embedding 模型（Phase 7 切到本地 HuggingFace）
EMBEDDING_PROVIDER_PHASE7=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32
EMBEDDING_FP16=true

# Scrapy 爬虫限速
CRAWL_DOWNLOAD_DELAY=1.5
CRAWL_CONCURRENT_PER_DOMAIN=2

# ETL 转换参数
ETL_CHUNK_SIZE=500
ETL_CHUNK_OVERLAP=50
ETL_MIN_QUALITY_SCORE=0.3

# Airflow
AIRFLOW_UID=50000
AIRFLOW_HOME=./airflow
