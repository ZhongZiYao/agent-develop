# ===== LLM（MiniMax，OpenAI 兼容 API）=====
LLM_PROVIDER=minimax
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.minimaxi.chat/v1
LLM_MODEL=MiniMax-Text-01
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# ===== Embedding（Ollama 本地）=====
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIM=1024

# ===== Vector Store =====
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=gameguide

# ===== 数据 =====
RAW_DATA_DIR=./data/raw
EVAL_DATA_DIR=./data/eval
PROCESSED_DATA_DIR=./data/processed

# ===== Splitter =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===== Retriever =====
TOP_K=10
TOP_N=5

# ===== Reranker（Phase 2 启用） =====
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-large

# ===== Query 处理（Phase 2 启用） =====
QUERY_REWRITE_ENABLED=false
HYDE_ENABLED=false

# ===== 服务 =====
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# ===== LangSmith（可选） =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gameguide-ai

# ===== 调试 =====
DEBUG=false